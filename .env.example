OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Opcional: modelo do LLM-as-a-judge. Vazio usa o OPENAI_CHAT_MODEL.
OPENAI_JUDGE_MODEL=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/rag_db

APP_ENV=development
OBSERVABILITY_ENABLED=false
# Optional generic input guardrails (openai-guardrails), off by default.
OPENAI_GUARDRAILS_ENABLED=false
OBSERVABILITY_SAMPLE_RATE=1.0
OBSERVABILITY_CAPTURE_CONTENT=false
OTEL_SERVICE_NAME=fcai-rag-api
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

AI_ALLOWED_MODELS=gpt-4.1-mini
AI_MONTHLY_BUDGET_USD=10.0
AI_MAX_OUTPUT_TOKENS=1200
AI_USAGE_LEDGER_PATH=data/ai_usage.jsonl
